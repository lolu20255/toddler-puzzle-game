{
  "appId": "com.blackboxcode.toddlerpuzzle",
  "appName": "ABC Kids Puzzle Pals",
  "webDir": "dist",
  "backgroundColor": "#6a5ae0",
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#6a5ae0",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true,
      "launchFadeOutDuration": 0
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#5bb6ef"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
