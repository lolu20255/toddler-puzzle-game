# ──────────────────────────────────────────────────────────────
# Native app configuration. Copy this file to `.env` and fill in.
# Vite only exposes variables prefixed with VITE_.
#
# Env-file precedence (Vite default):
#   npm run dev   → .env + .env.local + .env.development + .env.development.local
#   npm run build → .env + .env.local + .env.production  + .env.production.local
#
# In this repo:
#   .env             — gitignored, your local dev overrides (e.g. localhost API)
#   .env.production  — committed, public prod URLs / no secrets
# ──────────────────────────────────────────────────────────────

# RevenueCat public SDK keys — https://app.revenuecat.com → Project → API keys
VITE_REVENUECAT_API_KEY_IOS=
VITE_REVENUECAT_API_KEY_ANDROID=

# Store listing URLs — used by the in-app "Rate us" deep link
VITE_PROD_IOS_LINK=
VITE_PROD_ANDROID_LINK=

# libro-ai pronunciation backend.
#   Local dev:  put http://localhost:3000 in .env (the gitignored one)
#   Production: already set in .env.production to https://libro-ai.blackboxcode.io
# Override here only if you want something different from both.
# VITE_LIBRO_API_BASE_URL=

# Pronunciation voice provider. Allowlist (enforced by the backend):
#   - elevenlabs  (voice NoOVOzCQFLOvtsMoNcdT — current default)
#   - openai      (the backend's own default if omitted)
# Anything else → backend returns 422 and the celebration modal silently skips audio.
# VITE_LIBRO_PRONUNCIATION_PROVIDER=elevenlabs
