# Production env. Auto-loaded by Vite on `npm run build` (and therefore by
# `npm run build:ios` and `npm run build:android`). Loaded ON TOP of `.env`
# so it overrides any local-dev values.
#
# No secrets here — this file IS committed to git. Publishable CLIENT keys
# (e.g. RevenueCat public SDK keys, which ship inside the app anyway) are fine.
# Put any real SECRET keys in `.env` (gitignored) instead.

# libro-ai pronunciation backend — production.
VITE_LIBRO_API_BASE_URL=https://libro-ai.blackboxcode.io
# VITE_LIBRO_API_BASE_URL=https://d82e-2600-1700-f230-1260-6057-666f-f516-8ae0.ngrok-free.app


# Pronunciation voice provider — ElevenLabs (voice NoOVOzCQFLOvtsMoNcdT).
VITE_LIBRO_PRONUNCIATION_PROVIDER=elevenlabs


# RevenueCat PUBLIC SDK keys (per platform). These are publishable client keys
# meant to be embedded in the shipped app binary — NOT secrets — so they live
# here (committed) to guarantee every production build (CI, fresh clone) can
# reach RevenueCat. The RevenueCat *secret* API key is never used in the app.
# iOS = appl_, Android = goog_.
VITE_REVENUECAT_API_KEY_IOS=appl_MiUzXXTlZMYSJzAMHEWdXgNCHMi
# Fill in once the Google Play product is set up:
VITE_REVENUECAT_API_KEY_ANDROID=
