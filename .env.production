# Production env. Auto-loaded by Vite on `npm run build` (and therefore by
# `npm run build:ios` and `npm run build:android`). Loaded ON TOP of `.env`
# so it overrides any local-dev values.
#
# No secrets here — this file IS committed to git. Put any real keys in
# `.env` (gitignored) instead.

# libro-ai pronunciation backend — production.
VITE_LIBRO_API_BASE_URL=https://libro-ai.blackboxcode.io
# VITE_LIBRO_API_BASE_URL=https://d82e-2600-1700-f230-1260-6057-666f-f516-8ae0.ngrok-free.app


# Pronunciation voice provider — ElevenLabs (voice NoOVOzCQFLOvtsMoNcdT).
VITE_LIBRO_PRONUNCIATION_PROVIDER=elevenlabs
